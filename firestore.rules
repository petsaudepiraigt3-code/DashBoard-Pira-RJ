rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function para verificar se o usuário autenticado é ADMIN
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'ADMIN';
    }

    // Helper function para obter a unidade do usuário autenticado no Firestore
    function getUserUnitId() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.unidadeId;
    }

    // Coleção usuarios
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Coleção microareas
    match /microareas/{microareaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Coleção auditLogs
    match /auditLogs/{logId} {
      allow read, create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Coleção pacientes - Leitura por perfil e unidadeId
    match /pacientes/{patientId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        resource.data.unidadeId == getUserUnitId() ||
        resource.data.unidadeId == null
      );
      allow write: if request.auth != null;
    }

    // Regra global padrão para usuários autenticados
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
